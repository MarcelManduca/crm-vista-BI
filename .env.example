# Dashboard Gralha - Environment Variables

# Application
APP_NAME=Dashboard Gralha
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# Database PostgreSQL
DATABASE_URL=postgresql://gralha:gralha_password@db:5432/dashboard_gralha
DB_HOST=db
DB_PORT=5432
DB_USER=gralha
DB_PASSWORD=gralha_password
DB_NAME=dashboard_gralha

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Vista CRM (Loft)
VISTA_API_BASE_URL=https://novovista-rest.vistahost.com.br/api
VISTA_API_KEY=your-vista-api-key
VISTA_TENANT_ID=your-tenant-id

# Synchronization
SYNC_INTERVAL_HOURS=24
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=5

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=False

# Feature Flags
ENABLE_WEBHOOKS=False
ENABLE_ALERTS=False
ENABLE_EXPORT=True
